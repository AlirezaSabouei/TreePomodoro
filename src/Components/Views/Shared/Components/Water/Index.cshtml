        @*   Toggle End *@
        @* </button> *@
        <div class="position-relative">
            <button class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#waterContent"
                    aria-expanded="true"
                    aria-controls="waterContent">
                <span class="collapsed-show">▼</span>
                <span class="collapsed-hide">▲</span>
            </button>

            <h5 class="text-nowrap mb-2">🥤 Water Intake Tracker</h5>

            <div class="collapse show" id="waterContent">
                <span class="d-block mb-1">Get hydrated!</span>
                <ul>
                    @foreach (var glass in Model)
                    {
                        <li>💧</li>
                    }
                    <li id="btnAddGlass" class="add-water">➕</li>
                </ul>
            </div>
        </div>
    </div>
</div>


<style>
    .collapse.show ~ button .collapsed-show,
    .collapse:not(.show) ~ button .collapsed-hide {
        display: none;
    }

    /* Alternative: using collapse state on button */
    [data-bs-toggle="collapse"][aria-expanded="true"] .collapsed-show {
        display: none;
    }

    [data-bs-toggle="collapse"][aria-expanded="false"] .collapsed-hide {
        display: none;
    }
</style>

<script>

    $("#btnAddGlass").on('click', function () {
        RefreshGlasses('@((int)RequestType.Add)');
    });

    function RefreshGlasses(requestType, callback) {
        $('#water-container').load('@Url.Action("LoadWater", "Home")?requestType=' + requestType, function () {
            if (typeof callback === 'function') {
                callback(); // run callback after load completes
            }
        });
    }

</script>